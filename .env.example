# Environment Configuration for CodeRAG

# Qdrant Vector Database
# Leave empty or set to ':memory:' or './qdrant_data' for embedded local mode without Docker.
# Or use 'http://localhost:6333' for Docker / remote Qdrant instance.
QDRANT_URL=./qdrant_data
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=coderag_corpus

# Embeddings
# Options: 'BAAI/bge-small-en-v1.5', 'BAAI/bge-base-en-v1.5', 'text-embedding-3-small'
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# LLM Generation Provider
# Options: 'mock', 'groq', 'openai', 'anthropic'
LLM_PROVIDER=mock
DEFAULT_MODEL=mock-code-expert

# API Keys (Set the ones you use)
GROQ_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=

# Observability (Langfuse) - Optional
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Re-index Protection Key (Admin)
REINDEX_API_KEY=coderag-secret-reindex-key-1234

